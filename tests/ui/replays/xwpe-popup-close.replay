# xwpe File-Manager dismiss smoke. The Esc key must close the dialog.
# Keyboard dismissal is used deliberately: the File-Manager is laid out in
# character cells whose pixel position depends on the font metrics, the SDL
# version, and the directory contents, so no fixed mouse coordinate can hit
# its close gadget across platforms. Esc exercises the same teardown path
# without a coordinate dependency.
delay 1000
wait-window "xwpe|xwe|Xwpe|Xwe|File_Manager" 8000
wait-converge 200 2 50 200 15000
screenshot initial
key 27
delay 500
wait-converge 200 2 50 200 5000
screenshot clicked
assert-image clicked common-visible.json
assert-image clicked xwpe-dialog-closed.json
assert-exit running
