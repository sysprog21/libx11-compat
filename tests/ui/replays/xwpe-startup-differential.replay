# System-X11 and libx11-compat xwpe startup differential capture. Both sides
# open the File-Manager the X11 frontend shows at startup; the capture is
# input-free so it runs identically under the xdotool (system) and internal
# (compat) backends.
delay 1000
wait-window "xwpe|xwe|Xwpe|Xwe|File_Manager|Programming" 8000
wait-converge 200 2 50 200 15000
screenshot startup
assert-image startup common-visible.json
assert-exit running
