# xwpe resize smoke: the editor grid must survive a top-level resize. Under
# Option 1b the window keeps a constant font size and gains rows/cols instead of
# stretching, so the resized frame must still show non-blank editor content.
delay 1000
wait-window "xwpe|xwe|Xwpe|Xwe|File_Manager" 8000
wait-converge 200 2 50 200 15000
screenshot initial
resize 1100 800
delay 1000
wait-converge 200 2 50 200 8000
screenshot resized
assert-image resized common-visible.json
assert-image resized xwpe-resize-content.json
assert-exit running
