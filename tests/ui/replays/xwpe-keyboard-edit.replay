# xwpe editor keyboard smoke. Open a fixture, focus the text area, and type.
delay 1000
wait-window "xwpe|xwe|Xwpe|Xwe|File_Manager" 8000
wait-converge 200 2 50 200 15000
focus-at 40 120
target-motion 40 120
button 1 click
delay 300
wait-converge 200 2 50 200 5000
screenshot focused
key 97
delay 600
wait-converge 200 2 50 200 5000
screenshot typed
assert-image typed common-visible.json
assert-image typed xwpe-keyboard-inserted.json
assert-exit running
