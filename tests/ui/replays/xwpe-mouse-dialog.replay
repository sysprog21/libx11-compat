# xwpe File-Manager mouse smoke. A left click inside the file list must route
# to the application and produce a visible response (the selection and the
# Name field update). The list pane is a large target that stays under the
# same screen coordinate on every platform, so this checks mouse delivery
# without depending on the pixel-exact position of any one widget.
delay 1000
wait-window "xwpe|xwe|Xwpe|Xwe|File_Manager" 8000
wait-converge 200 2 50 200 15000
screenshot initial
target-motion 440 250
button 1 click
delay 500
wait-converge 200 2 50 200 5000
screenshot clicked
assert-image clicked common-visible.json
assert-image clicked xwpe-mouse-response.json
assert-exit running
