--- a/glib/gconvert.c
+++ b/glib/gconvert.c
@@ -929,6 +929,34 @@ strdup_len (const gchar *string,
 
 #endif
 
+static gchar *
+filename_fallback_dup (const gchar *string,
+		       gsize       len,
+		       gsize       *bytes_read,
+		       gsize       *bytes_written,
+		       GError      **error)
+{
+  gsize real_len;
+
+  g_clear_error (error);
+
+  if (len == (gsize)-1)
+    real_len = strlen (string);
+  else
+    {
+      real_len = 0;
+      while (real_len < len && string[real_len])
+	real_len++;
+    }
+
+  if (bytes_read)
+    *bytes_read = real_len;
+  if (bytes_written)
+    *bytes_written = real_len;
+
+  return g_strndup (string, real_len);
+}
+
 /**
  * g_locale_to_utf8:
