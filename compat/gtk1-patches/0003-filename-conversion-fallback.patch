+  if (have_broken_filenames ())
+    result = g_locale_to_utf8 (opsysstring, len,
+			       bytes_read, bytes_written,
+			       error);
   else
-    return strdup_len (opsysstring, len, bytes_read, bytes_written, error);
+    result = strdup_len (opsysstring, len, bytes_read, bytes_written, error);
+  return result ? result : filename_fallback_dup (opsysstring, len,
+						  bytes_read, bytes_written,
+						  error);
 #endif /* !G_PLATFORM_WIN32 */
 }
 
