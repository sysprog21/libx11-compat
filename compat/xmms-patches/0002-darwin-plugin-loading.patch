Darwin dlsym() expects the C symbol name, not the Mach-O underscored linker
name. The configure-time SYMBOL_PREFIX value makes XMMS look up "_get_*" and
silently skip every plugin. Load plugins lazily as well; XMMS plugins resolve
some callbacks from the main executable.

--- a/xmms/pluginenum.c
+++ b/xmms/pluginenum.c
@@ -223,7 +223,11 @@ static void* open_dynamic_lib(char *filename)
 	 */
 	return shl_load(filename, BIND_DEFERRED, 0); 
 #else
+#ifdef __APPLE__
+	return dlopen(filename, RTLD_LAZY);
+#else
 	return dlopen(filename, RTLD_NOW);
+#endif
 #endif
 }
 
@@ -245,7 +249,7 @@ static void* find_dynamic_symbol(void *handle, char *symbol)
 		gpi = NULL;
 	return gpi;
 #else
-#ifdef SYMBOL_PREFIX
+#if defined(SYMBOL_PREFIX) && !defined(__APPLE__)
 	char *sym = g_strconcat(SYMBOL_PREFIX, symbol, NULL);
 	void *symh = dlsym(handle, sym);
 	g_free(sym);
