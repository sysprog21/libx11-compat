+static void
+file_filter_selection (PluginProc *proc, GtkWidget *filesel)
+{
+    if (!proc->extensions_list)
+    {   return;
+    }
+    char *ext = (char *) proc->extensions_list->data;
+    if (!ext || !ext[0])
+    {   return;
+    }
+    GString *pattern = g_string_new ("*.");
+    g_string_append (pattern, ext);
+    gtk_file_selection_complete (GTK_FILE_SELECTION(filesel), pattern->str);
+    g_string_free (pattern, TRUE);
+}
