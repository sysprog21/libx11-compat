 /*
  * ----------------------------------------------------------------------------
  *
+ * W3DhandleEvent --
+ *
+ *	Handle pointer events for the 3D window before the generic macro path
+ *	sees them.
+ *
+ * ----------------------------------------------------------------------------
+ */
+
+bool
+W3DhandleEvent(w, xevent)
+    MagWindow *w;
+    XEvent *xevent;
+{
+    W3DclientRec *crec;
+
+    if ((w == (MagWindow *)NULL) || (w->w_clientData == (ClientData)NULL))
+	return FALSE;
+
+    crec = (W3DclientRec *)w->w_clientData;
+
+    switch (xevent->type)
+    {
+	case ButtonPress:
+	    if (xevent->xbutton.button != Button1) return FALSE;
+	    crec->dragging = TRUE;
+	    crec->drag_x = xevent->xbutton.x;
+	    crec->drag_y = xevent->xbutton.y;
+	    return TRUE;
+	case ButtonRelease:
+	    if (xevent->xbutton.button != Button1) return FALSE;
+	    crec->dragging = FALSE;
+	    return TRUE;
+	case MotionNotify:
+	    if (!crec->dragging)
+		return TRUE;
+	    crec->view_y += (float)(xevent->xmotion.x - crec->drag_x);
+	    crec->view_x += (float)(xevent->xmotion.y - crec->drag_y);
+	    crec->drag_x = xevent->xmotion.x;
+	    crec->drag_y = xevent->xmotion.y;
+	    w3drefreshFunc(w);
+	    return TRUE;
+    }
+
+    return FALSE;
+}
