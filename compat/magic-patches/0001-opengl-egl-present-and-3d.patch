+/*
+ * w3dPresent --
+ *	Present the completed 3D frame to the screen.
+ *
+ *	Magic draws to GL_FRONT and relies on the X server showing those draws
+ *	immediately.  On the EGL/GLES stack (gl4es over ANGLE) nothing reaches
+ *	the screen until eglSwapBuffers, which libx11-compat issues from
+ *	glXSwapBuffers; without this the 3D window stays blank.  Call this once
+ *	at the end of a full redisplay rather than in w3dUnlock: a redisplay
+ *	locks and unlocks several times (once per visible style) but starts with
+ *	w3dClear and accumulates every style into one buffer, so a single swap
+ *	here presents the whole frame, where a per-unlock swap would flip the
+ *	buffer mid-frame and drop the styles drawn before it.
+ */
+
+void
+w3dPresent(w)
+    MagWindow *w;
+{
+    Window wind;
+    /* w_grdata is null while the widget is being torn down (the race the
+     * wrapper.tcl "winfo exists" guard dodges); Tk_WindowId(NULL) would
+     * dereference a bad pointer, so bail before calling it.
+     */
+    if (w == (MagWindow *)NULL || w->w_grdata == (ClientData)NULL) return;
+    wind = Tk_WindowId((Tk_Window)w->w_grdata);
+    if (wind != 0)
+	glXSwapBuffers(grXdpy, (GLXDrawable)wind);
+}
+
